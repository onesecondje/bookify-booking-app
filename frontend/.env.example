# Server-side API origin. This is read by Next.js, not by the browser.
BACKEND_API_URL=http://127.0.0.1:4000
# The seeded demo business; change this to display another existing business.
BOOKIFY_BUSINESS_ID=10000000-0000-4000-8000-000000000001

# Optional business dashboard settings. Match the managed ID and API token in the backend.
BOOKIFY_MANAGED_BUSINESS_ID=
BOOKIFY_BUSINESS_BOOKINGS_TOKEN=
# Separate browser login password for username business (at least 32 characters).
BOOKIFY_DASHBOARD_PASSWORD=
