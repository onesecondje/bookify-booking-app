# Copy this file to .env to configure your local backend.
PORT=4000
# Match the database settings in the root .env. This password is an example only.
DATABASE_URL=postgresql://bookify:change_me_local_only@127.0.0.1:5432/bookify

# Optional. Set both to enable the business bookings endpoint.
BOOKIFY_MANAGED_BUSINESS_ID=
# Generate a random server-side secret (at least 32 base64url characters).
BOOKIFY_BUSINESS_BOOKINGS_TOKEN=
